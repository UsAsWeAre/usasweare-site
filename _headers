# Cloudflare Pages response headers. Hidden from search engines until the publishing push (Keegan, 2026-10-16).
# script-src 'self': Cloudflare's email-address decoder (/cdn-cgi/...), so the footer address shows. news.usasweare.org: Owner Controls.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' https://news.usasweare.org; connect-src https://news.usasweare.org; style-src 'unsafe-inline'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
